<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over the main manifest only in builds with Discord's Social SDK (app/build.gradle.kts). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The SDK asks for these for voice chat, which Tandem doesn't use. It keeps INTERNET (already Tandem's). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" tools:node="remove" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />

    <application>
        <!-- Connecting a Discord account: Discord (or a browser) sends the authorization back to
             discord-<application ID>:/authorize/callback, the redirect registered for the Discord application. -->
        <activity
            android:name="com.discord.socialsdk.AuthenticationActivity"
            android:exported="true"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${discordScheme}" />
            </intent-filter>
        </activity>
        <!-- Only for voice calls. -->
        <service android:name="com.discord.socialsdk.ForegroundService" tools:node="remove" />
    </application>
</manifest>
