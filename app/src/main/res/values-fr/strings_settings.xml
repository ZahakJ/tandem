    <string name="settings_sub_wallpaper">Fond d’écran</string>
    <string name="settings_sub_wallpaper_help">Le fond d’écran de chaque écran, et à quel point les images et vidéos sont assombries.</string>
    <string name="settings_sub_motion">Animations</string>
    <string name="settings_sub_motion_help">Comment tout bouge : le style d’animation, Réduire les animations, les titres flottants, l’énergie de l’ensemble et la façon dont les écrans s’inversent.</string>
    <string name="settings_sub_grid">Forme de la grille</string>
    <string name="settings_sub_grid_help">Les lignes de la grille d’icônes, l’arrondi des icônes, l’espace entre elles et les visuels au-dessus de la grille.</string>
    <string name="settings_sub_games">Affichage des jeux</string>
    <string name="settings_sub_games_help">Comment les jeux s’affichent dans un système ou une collection : la vue, sa taille, la forme des cartes, l’étagère et les titres.</string>
    <string name="settings_sub_dock">Dock et widgets</string>
    <string name="settings_sub_dock_help">Le dock d’applis le long de l’écran d’accueil, et ses widgets.</string>
    <string name="settings_sub_art">Visuels et vidéo</string>
    <string name="settings_sub_art_help">Les visuels de l’autre écran : aperçus vidéo, visuels animés, taille du logo et fondu des visuels.</string>
    <string name="settings_sub_pads">Manettes connectées</string>
    <string name="settings_sub_pads_help">Manettes Bluetooth et USB : boutons façon Nintendo pour chacune, et le rôle de leur bouton Home.</string>
    <string name="settings_sub_deck">Deck</string>
    <string name="settings_sub_deck_help">Le Deck : le clavier et le pavé tactile sur l’écran du bas, pour les jeux PC et le streaming.</string>
    <string name="settings_sub_accounts">Comptes</string>
    <string name="settings_sub_accounts_help">Les succès RetroAchievements et Steam, et ton statut Discord.</string>
    <string name="settings_sub_perf">Performances et veille</string>
    <string name="settings_sub_perf_help">Mode performance, ventilateur et fréquence d’actualisation pendant le jeu, et la mise en pause des jeux quand la console est en veille.</string>
    <string name="settings_sub_privacy">Confidentialité et masqués</string>
    <string name="settings_sub_privacy_help">Le mode privé et son code PIN, l’affichage des jeux masqués, et passer hors ligne pendant qu’un jeu masqué tourne.</string>
    <string name="settings_sub_data">Tes données</string>
    <string name="settings_sub_data_help">Sauvegarder et restaurer, récupérer ta config Cocoon et les infos des fichiers gamelist.xml, et exporter tes stats de jeu.</string>
    <string name="settings_sub_dev">Pour les bidouilleurs</string>
    <string name="settings_sub_dev_help">Des outils pour mesurer la fluidité et vérifier les thèmes. Tu n’en auras pas besoin.</string>

