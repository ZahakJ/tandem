    <!-- What each page holds, in a sentence (the side panel beside its tile). -->
    <string name="settings_page_look_blurb">Thèmes et packs de thèmes, couleurs, fonds d’écran, icônes des systèmes, animations et langue.</string>
    <string name="settings_page_home_blurb">La disposition de ton accueil et son écran, l’affichage des jeux dans un système, le dock et les widgets, l’horloge et l’économiseur d’écran.</string>
    <string name="settings_page_screens_blurb">Ce que montre chaque écran, quand tu navigues et quand tu joues : un écran ou deux, les inverser, les visuels de l’autre écran, et déplacer des applis de l’un à l’autre.</string>
    <string name="settings_page_sound_blurb">La musique et les sons du pack de thème, les sons de l’interface, la voix de Pip, et ta musique ou la bande-son intégrée.</string>
    <string name="settings_page_controls_blurb">Icônes des boutons, A/B et X/Y inversés, réassigner n’importe quel bouton, tes manettes et le Deck.</string>
    <string name="settings_page_library_blurb">Dossiers de jeux, analyse et tri, systèmes et émulateurs, visuels et leurs sources, et tes comptes RetroAchievements et Steam.</string>
    <!-- The same, in builds with Discord. -->
    <string name="settings_page_library_blurb_discord">Dossiers de jeux, analyse et tri, systèmes et émulateurs, visuels et leurs sources, et tes comptes RetroAchievements, Steam et Discord.</string>
    <string name="settings_page_play_blurb">Reprendre et fermer les jeux, performances, confidentialité et jeux masqués, sauvegardes, Tandem comme écran d’accueil, et mises à jour.</string>

