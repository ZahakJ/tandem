    <!-- The seven pages: their tiles on the first Settings screen, their titles, and the top bar. -->
    <string name="settings_page_look">Apparence</string>
    <string name="settings_page_home">Accueil et disposition</string>
    <string name="settings_page_screens">Deux écrans</string>
    <string name="settings_page_sound">Son et musique</string>
