    <!-- %1$d is the download's size in MB. -->
    <string name="scrape_guide_lb_1">Tandem télécharge une fois la base de jeux gratuite de LaunchBox (environ %1$d Mo, Wi-Fi conseillé) et ne garde que tes systèmes.</string>
    <string name="scrape_guide_lb_2">Les jeux sont cherchés directement sur l’appareil. La base se met à jour une fois par mois, quand tu scrapes en Wi-Fi.</string>
    <string name="scrape_guide_lb_sends">Rien sur tes jeux. Les images viennent de images.launchbox-app.com.</string>
    <string name="scrape_guide_ss_account">Compte gratuit + ID développeur</string>
    <string name="scrape_guide_ss_1">Crée un compte gratuit sur screenscraper.fr.</string>
    <!-- "Demande d'accès à l'API" is the name of a forum section on the French site: keep it in French. -->
    <string name="scrape_guide_ss_2">Demande un accès à l’API sur leur forum («   Demande d’accès à l’API   ») pour obtenir un ID et un mot de passe développeur. Tandem ne peut pas en fournir.</string>
    <string name="scrape_guide_ss_3">Saisis-les tous les deux ci-dessous. Ton propre identifiant est facultatif, mais il t’offre un plus gros quota par jour.</string>
    <string name="scrape_guide_ss_sends">Ton identifiant, l’ID développeur, et pour chaque jeu le nom du fichier, sa taille, son système et sa somme de contrôle.</string>
    <string name="scrape_guide_igdb_account">Compte Twitch gratuit</string>
    <string name="scrape_guide_igdb_1">Connecte-toi sur dev.twitch.tv/console/apps (Twitch demande d’abord la double authentification).</string>
    <!-- Register Your Application, Application Integration, Confidential, Client ID, New Secret and Client Secret are
         what Twitch's website calls things, in English. -->
    <string name="scrape_guide_igdb_2">Register Your Application : n’importe quel nom, URL de redirection http://localhost, catégorie Application Integration, type de client Confidential.</string>
    <string name="scrape_guide_igdb_3">Copie le Client ID, appuie sur New Secret, puis copie le Client Secret.</string>
    <string name="scrape_guide_igdb_sends">Ton ID client et ton secret (à Twitch), et le titre de chaque jeu.</string>
    <string name="scrape_guide_sgdb_account">Compte gratuit</string>
    <string name="scrape_guide_sgdb_1">Connecte-toi sur steamgriddb.com (avec ton compte Steam).</string>
    <string name="scrape_guide_sgdb_2">Ouvre steamgriddb.com/profile/preferences/api.</string>
    <string name="scrape_guide_sgdb_3">Génère une clé API et saisis-la ci-dessous.</string>
    <string name="scrape_guide_sgdb_sends">Ta clé API et le titre de chaque jeu.</string>
    <string name="scrape_guide_libretro_1">Toujours prêt. Parfait pour les systèmes rétro ; rien en revanche pour les jeux Switch, Wii U ou PC.</string>
    <string name="scrape_guide_libretro_sends">Des noms d’images tirés du nom de fichier ou du titre de chaque jeu.</string>
    <string name="scrape_guide_hltb_1">Utilise la même recherche que le site howlongtobeat.com. Ce n’est pas une API officielle, elle peut donc cesser de marcher si le site change ; le scraping la saute alors, tout simplement.</string>
    <string name="scrape_guide_hltb_2">Les durées s’affichent sur l’écran du bas.</string>
    <string name="scrape_guide_hltb_sends">Le titre de chaque jeu.</string>

