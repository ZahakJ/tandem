    <string name="look_accent">Couleur d’accent</string>
    <string name="look_accent_help">Ta propre couleur pour les interrupteurs et le curseur. Gauche et droite essaient les teintes ; A les montre toutes, et Saisir une couleur… accepte n’importe laquelle, comme #FF7AB6.</string>
    <!-- The accent option that keeps the theme's own accent. -->
    <string name="look_accent_theme">Thème</string>
    <string name="look_accent_type">Saisir une couleur…</string>
    <!-- The keyboard's title when typing a colour like #FF7AB6. -->
    <string name="look_accent_hex">Couleur d’accent (hexa)</string>
    <string name="look_accent_bad">Ça ne ressemble pas à une couleur</string>
    <string name="look_highlight">Style du curseur</string>
    <string name="look_highlight_help">Comment la carte sélectionnée se distingue : une lueur douce, un contour net, un relief avec une grande ombre, ou un anneau qui pulse doucement.</string>
    <string name="look_surface">Matière</string>
    <string name="look_surface_help">De quoi sont faites les cartes : pleines, en verre dépoli qui laisse briller le fond d’écran, ou de simples contours.</string>

    <string name="look_icon_style">Style des icônes</string>
    <string name="look_icon_style_help">Comment Tandem dessine les icônes des systèmes quand un pack de thème n’apporte pas les siennes : une petite console du bon genre avec le nom du système, en bulles brillantes, tubes néon, pixels, LCD, chrome et plus encore.</string>
    <string name="look_icons_from">Icônes de</string>
    <string name="look_icons_from_help">Utilise les icônes de systèmes, bannières et logos d’un pack avec n’importe quel thème, ou fais-les toujours dessiner. « Auto » prend les visuels du pack de thème ; avec un thème intégré, il emprunte le premier pack de dossiers intelligents Cocoon trouvé dans ROMs/assets/smart_folders. « Dessinées par Tandem » suit le style des icônes du thème.</string>
    <!-- Icons from options; the others are the names of installed packs. -->
    <string name="look_icons_from_auto">Auto</string>
    <string name="look_icons_from_drawn">Dessinées par Tandem</string>

    <string name="look_animation">Style d’animation</string>
    <string name="look_animation_help">Rebondi est joueur, Fluide glisse sans dépasser, Sobre est rapide et discret, Désactivé change tout d’un coup.</string>
    <string name="look_reduce_motion">Réduire les animations</string>
    <string name="look_reduce_motion_help">Coupe partout les fonds animés, les visuels qui défilent et les animations qui rebondissent. L’économiseur de batterie fait pareil pour les fonds d’écran.</string>

    <!-- Wallpaper: Top screen and Bottom screen offer the backdrops (look_backdrop_…), these two and the user's own files. -->
    <string name="look_wall_theme">Celui du thème</string>
    <string name="look_wall_hero">Visuel du jeu (flouté)</string>
    <string name="look_wall_top">Écran du haut</string>
    <string name="look_wall_top_help">Un fond animé, le visuel du jeu sélectionné, ou ta propre image ou vidéo : copie des images (PNG, JPG, WebP) ou des vidéos (MP4, WebM) dans ROMs/tandem/wallpapers et elles apparaissent ici.</string>
    <string name="look_wall_bottom">Écran du bas</string>
    <string name="look_wall_bottom_help">Les mêmes choix pour le second écran. Les visuels de jeux et les vidéos y font un effet fou.</string>
    <string name="look_wall_dim">Assombrir l’image</string>
    <string name="look_wall_dim_help">Assombrit les fonds d’écran image et vidéo pour que le texte par-dessus reste bien lisible.</string>

    <string name="look_games_view">Affichage des jeux</string>
    <string name="look_games_view_help">Comment les jeux s’affichent dans un système ou une collection : une grille de cartes, une liste avec les infos (idéale pour les grosses bibliothèques), un carrousel, des tranches sur une étagère, ou des cartouches dans un boîtier.</string>
    <string name="look_games_grid_size">Taille de la grille</string>
    <string name="look_games_grid_size_help">La taille des cartes de jeux dans un système, ou un nombre fixe de colonnes.</string>
    <string name="look_games_card_shape">Forme des cartes</string>
    <string name="look_games_card_shape_help">Arrondies, carrées, rondes, hautes comme des jaquettes, ou larges pour les captures et les bannières.</string>
    <string name="look_games_shelf_look">Style de l’étagère</string>
    <string name="look_games_shelf_look_help">Le meuble derrière la vue Étagère d’un dossier : bois chaleureux, planches mates aux couleurs du thème, ou ouvert, avec les boîtiers posés sur ton fond d’écran et juste une fine ligne d’étagère.</string>
    <string name="look_games_titles">Titres des jeux</string>
    <string name="look_games_titles_help">Écrit le nom de chaque jeu sous sa carte.</string>
    <string name="look_home_system_tiles">Vignettes des systèmes</string>
    <string name="look_home_system_tiles_help">L’apparence des vignettes de systèmes sur l’accueil.</string>
    <string name="look_home_rows">Rayons de l’accueil</string>
    <string name="look_home_rows_help">Quels rayons l’accueil affiche, et dans quel ordre.</string>
    <string name="look_home_open_folders">Ouvrir les dossiers</string>
    <string name="look_home_open_folders_help">En page, en page plein écran (la barre du haut s’efface pour laisser tout l’écran à la grille), ou en pop-up par-dessus l’écran où tu es.</string>
    <string name="look_home_open_folders_page">Page</string>
    <string name="look_home_open_folders_fullscreen">Plein écran</string>
    <string name="look_home_open_folders_popup">Pop-up</string>
    <string name="look_home_now_playing">En jeu</string>
    <string name="look_home_now_playing_help">Quand un jeu tourne en arrière-plan, il s’affiche en haut de l’accueil pour que tu y replonges d’un bond.</string>
    <string name="look_corner_hints">Aide dans le coin</string>
    <string name="look_corner_hints_help">Un petit pense-bête des boutons dans le coin de l’écran du haut.</string>

    <string name="look_dock_apps">Dock d’applis</string>
    <string name="look_dock_apps_help">Tes applis Android préférées sur l’accueil. Appuie sur Y sur l’une d’elles pour la déplacer ou la retirer.</string>
    <string name="look_dock_style">Style du dock</string>
    <string name="look_dock_style_help">Une barre flottante, une tablette sur toute la largeur, ou juste les icônes. S’applique à toutes les dispositions sauf Rayons.</string>
    <string name="look_dock_top">Dock en haut</string>
    <string name="look_dock_top_help">Place le dock au-dessus des vignettes plutôt qu’en dessous.</string>
    <string name="look_dock_auto_hide">Dock rétractable</string>
    <string name="look_dock_auto_hide_help">Le dock reste petit et discret jusqu’à ce que tu y ailles.</string>

    <!-- The bottom screen's style while you browse (Two screens › Other screen). -->
    <string name="look_bottom_style">Style</string>
    <string name="look_bottom_style_help">Infos montre le visuel du jeu qui se fond dans sa fiche. Visuel + infos laisse le visuel animé remplir l’écran, les infos par-dessus. Visuel animé, c’est le plaisir des yeux, rien d’autre. Horloge reste tout calme.</string>
    <string name="look_bottom_logo_size">Taille du logo</string>
    <string name="look_bottom_logo_size_help">La taille du logo du jeu sur son visuel.</string>
    <string name="look_bottom_art_fade">Fondu du visuel</string>
    <string name="look_bottom_art_fade_help">Comment le visuel se fond dans le fond en dessous.</string>
    <string name="look_bottom_video_snaps">Aperçus vidéo</string>
    <string name="look_bottom_video_snaps_help">Lance la vidéo d’un jeu (depuis ROMs/downloaded_media/&lt;système&gt;/videos) quand tu t’attardes dessus. Rapide démarre plus tôt ; Économe attend plus longtemps pour qu’un défilement rapide ne décode jamais de vidéo. Toujours muette, et arrêtée pendant que tu joues.</string>
    <!-- Video snaps options: how soon a video starts. -->
    <string name="look_bottom_video_snaps_fast">Rapide</string>
    <string name="look_bottom_video_snaps_balanced">Équilibré</string>
    <string name="look_bottom_video_snaps_saver">Économe</string>
    <string name="look_bottom_moving_art">Visuels animés</string>
    <string name="look_bottom_moving_art_help">Le visuel du jeu glisse et zoome lentement, comme une affiche vivante.</string>

    <string name="look_top_battery">Batterie</string>
    <string name="look_top_battery_help">Affiche le pourcentage de batterie à côté de l’horloge.</string>
    <string name="look_top_clock">Horloge</string>
    <string name="look_top_clock_help">12 h, 24 h, comme le système, ou pas d’horloge du tout.</string>
    <string name="look_top_clock_system">Système</string>
    <string name="look_top_clock_12">12 h</string>
    <string name="look_top_clock_24">24 h</string>
    <string name="look_top_clock_hidden">Masquée</string>

    <string name="look_controls_prompts">Icônes des boutons</string>
    <string name="look_controls_prompts_help">Comment les boutons sont dessinés dans l’aide : les pastels de Tandem, ou le style Xbox, PlayStation ou Nintendo.</string>
    <string name="look_controls_swap_ab">Inverser A et B</string>
    <string name="look_controls_swap_ab_help">Valide avec B et reviens en arrière avec A, comme sur une console Nintendo. L’aide suit le mouvement.</string>
    <string name="look_controls_swap_xy">Inverser X et Y</string>
    <string name="look_controls_swap_xy_help">Cherche avec Y et ouvre les options avec X.</string>
    <!-- What a button does, under it in the Swap A and B / Swap X and Y pictures. Short. -->
    <string name="look_controls_does_open">Ouvrir</string>
    <string name="look_controls_does_search">Chercher</string>
    <string name="look_controls_does_options">Options</string>
    <string name="look_controls_rebind">Réassigner les boutons</string>
    <string name="look_controls_rebind_help">Donne à n’importe quelle commande de Tandem un autre bouton, un combo de boutons pressés ensemble, ou un bouton maintenu : ouvrir, retour, le menu d’options, Start, les réglages rapides, le sélecteur de jeux, le panneau latéral, le changement de page, les jeux masqués, et un bouton pour Favori, Capture d’écran et Clip. L’aide suit partout.</string>
    <!-- Rebind buttons, when nothing is rebound. -->
    <string name="look_controls_rebind_defaults">Par défaut</string>
    <!-- Rebind buttons: how many buttons are rebound. -->
    <plurals name="look_controls_rebind_changes">
        <item quantity="one">%1$d changement</item>
        <item quantity="other">%1$d changements</item>
    </plurals>

    <string name="look_screens_swap">Inverser les écrans</string>
    <string name="look_screens_swap_help">La bibliothèque passe sur l’écran du bas (tactile) et les infos en haut, instantanément. X fait la même chose sur la grille d’icônes. Les jeux s’ouvrent toujours sur l’écran du haut.</string>
    <string name="look_screens_rotation">Bloquer la rotation auto</string>
    <string name="look_screens_rotation_help">La Thor réactive la rotation automatique toute seule de temps en temps. Tandem la recoupe chaque fois que tu reviens. Désactive cette option pour choisir toi-même.</string>

    <string name="look_reset">Réinitialiser le look</string>
    <string name="look_reset_help">Retour au look d’origine de Tandem : thème, disposition, fonds d’écran, icônes et animations. Tes boutons, écrans, sons et musique, ta bibliothèque, tes favoris et ton temps de jeu ne bougent pas.</string>
    <string name="look_reset_ask">Réinitialiser tout le look ?</string>
    <string name="look_reset_ask_body">Thème, disposition, fonds d’écran, icônes et animations reviennent comme au premier jour. Boutons, écrans, son et jeux restent.</string>
    <string name="look_reset_ask_do">Réinitialiser</string>
    <!-- After Reset look: the theme it went back to, "Back to Pastel Night". -->
    <string name="look_reset_done">Retour à %1$s</string>

    <!-- Settings › Home & layout: the icon grid home (Appearance.kt). -->
    <string name="look_grid_icon_size">Taille des icônes</string>
    <string name="look_grid_icon_size_help">Combien d’icônes tiennent en largeur, comme le zoom du menu HOME de la 3DS. L1 et R1 la changent aussi sur la grille.</string>
    <!-- An Icon size option: a size name and how many icons fit across, "Medium · 7 across". -->
    <string name="look_grid_icon_size_option">%1$s · %2$d par ligne</string>
    <string name="look_grid_rows">Rangées d’icônes</string>
    <string name="look_grid_rows_help">Fixe le nombre de rangées et les icônes grandissent pour remplir l’écran. Une rangée, c’est le menu HOME de la 3DS zoomé au maximum : de grosses icônes, avec les infos de l’élément sélectionné au-dessus. Auto suit Taille des icônes. L1 et R1 changent les rangées sur la grille (L1 sur les grandes icônes continue vers moins de rangées).</string>
    <string name="look_grid_rows_auto">Auto</string>
    <!-- A Rows of icons option: how many rows of icons the grid has. -->
    <plurals name="look_grid_rows_n">
        <item quantity="one">%1$d rangée</item>
        <item quantity="other">%1$d rangées</item>
    </plurals>
    <string name="look_grid_scrolling">Défilement</string>
    <string name="look_grid_scrolling_help">Sur le côté avec un aperçu de la suite, une page à la fois (comme sur 3DS), ou de haut en bas.</string>
    <string name="look_grid_scrolling_sideways">Latéral</string>
    <string name="look_grid_scrolling_pages">Pages</string>
    <string name="look_grid_scrolling_vertical">Vertical</string>
    <string name="look_grid_roundness">Arrondi des icônes</string>
    <string name="look_grid_roundness_help">Des coins carrés jusqu’au cercle.</string>
    <string name="look_grid_gap">Espace entre icônes</string>
    <string name="look_grid_gap_help">L’écart entre les icônes, en part d’une icône.</string>
    <string name="look_grid_hero_split">Bannière au-dessus</string>
    <string name="look_grid_hero_split_help">Le visuel de l’icône sélectionnée au-dessus de la grille. Sans bannière (par défaut), les icônes ont tout l’écran.</string>
    <string name="look_grid_hero_split_none">Sans bannière</string>
    <string name="look_grid_other_screen">Autre écran</string>
    <string name="look_grid_other_screen_help">Vedette montre l’icône sélectionnée en grand sur sa couleur (ou le visuel de son pack d’icônes) et les jeux en plein écran. Classique affiche les infos de Tandem.</string>
    <string name="look_grid_other_screen_spotlight">Vedette</string>
    <string name="look_grid_other_screen_classic">Classique</string>
    <string name="look_grid_folders">Ouverture des dossiers</string>
    <string name="look_grid_folders_help">En grand panneau arrondi par-dessus la grille, ou en page entière.</string>
    <string name="look_grid_folders_popup">Sur la grille</string>
    <string name="look_grid_folders_page">Page entière</string>
    <string name="look_grid_x_button">Bouton X</string>
    <string name="look_grid_x_button_help">Inverse les deux écrans avec X sur les accueils Grille d’icônes et Orbite (la recherche est dans le panneau Start et le menu Y de la grille), partout, ou garde X pour la recherche.</string>
    <string name="look_grid_x_button_swap_grid">Inverser sur grille et Orbite</string>
    <string name="look_grid_x_button_swap">Inverser partout</string>
    <string name="look_grid_x_button_search">Rechercher</string>
    <string name="look_grid_swap_animation">Animation d’inversion</string>
    <string name="look_grid_swap_animation_help">Comment les écrans échangent leur place avec X. Éparpiller : les icônes s’envolent et atterrissent sur l’autre écran. Pousser : le nouveau contenu de chaque écran glisse depuis la charnière. Retourner : les deux écrans se retournent comme des cartes. Profondeur : l’ancien côté recule pendant que le nouveau s’avance.</string>
    <!-- Swap animation options: how the two screens trade places. -->
    <string name="look_swap_scatter">Éparpiller</string>
    <string name="look_swap_push">Pousser</string>
    <string name="look_swap_flip">Retourner</string>
    <string name="look_swap_depth">Profondeur</string>
    <string name="look_swap_fade">Fondu</string>
    <string name="look_swap_instant">Instantané</string>

    <!-- Home rows: the rows of the Shelves home, listed in order like "Continue · Systems · Collections". -->
