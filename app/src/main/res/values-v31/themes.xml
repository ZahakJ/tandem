<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the splash screen is only the backdrop colour, with a blank icon and no icon animation, so the
         starting window is a plain full-screen backdrop that Tandem's first frame fades over. -->
    <style name="Tandem.Start" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowBackground">@color/start_night</item>
        <item name="android:statusBarColor">@color/start_night</item>
        <item name="android:navigationBarColor">@color/start_night</item>
        <item name="android:windowSplashScreenBackground">@color/start_night</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/start_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
    </style>

    <!-- The same in other themes' colours (StartLook.STYLES); Android 13+ uses the one picked for the next start. -->
    <style name="Tandem.Start.Black"><item name="android:windowBackground">@color/start_black</item><item name="android:statusBarColor">@color/start_black</item><item name="android:navigationBarColor">@color/start_black</item><item name="android:windowSplashScreenBackground">@color/start_black</item></style>
    <style name="Tandem.Start.Navy"><item name="android:windowBackground">@color/start_navy</item><item name="android:statusBarColor">@color/start_navy</item><item name="android:navigationBarColor">@color/start_navy</item><item name="android:windowSplashScreenBackground">@color/start_navy</item></style>
    <style name="Tandem.Start.Violet"><item name="android:windowBackground">@color/start_violet</item><item name="android:statusBarColor">@color/start_violet</item><item name="android:navigationBarColor">@color/start_violet</item><item name="android:windowSplashScreenBackground">@color/start_violet</item></style>
    <style name="Tandem.Start.Slate"><item name="android:windowBackground">@color/start_slate</item><item name="android:statusBarColor">@color/start_slate</item><item name="android:navigationBarColor">@color/start_slate</item><item name="android:windowSplashScreenBackground">@color/start_slate</item></style>
    <style name="Tandem.Start.Green"><item name="android:windowBackground">@color/start_green</item><item name="android:statusBarColor">@color/start_green</item><item name="android:navigationBarColor">@color/start_green</item><item name="android:windowSplashScreenBackground">@color/start_green</item></style>
    <style name="Tandem.Start.Warm"><item name="android:windowBackground">@color/start_warm</item><item name="android:statusBarColor">@color/start_warm</item><item name="android:navigationBarColor">@color/start_warm</item><item name="android:windowSplashScreenBackground">@color/start_warm</item></style>
    <style name="Tandem.Start.Cream"><item name="android:windowBackground">@color/start_cream</item><item name="android:statusBarColor">@color/start_cream</item><item name="android:navigationBarColor">@color/start_cream</item><item name="android:windowSplashScreenBackground">@color/start_cream</item></style>
    <style name="Tandem.Start.Blush"><item name="android:windowBackground">@color/start_blush</item><item name="android:statusBarColor">@color/start_blush</item><item name="android:navigationBarColor">@color/start_blush</item><item name="android:windowSplashScreenBackground">@color/start_blush</item></style>
    <style name="Tandem.Start.Lime"><item name="android:windowBackground">@color/start_lime</item><item name="android:statusBarColor">@color/start_lime</item><item name="android:navigationBarColor">@color/start_lime</item><item name="android:windowSplashScreenBackground">@color/start_lime</item></style>
</resources>
