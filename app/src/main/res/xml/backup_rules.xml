<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: keep account keys, the LaunchBox index and its lookup cache out of cloud and device backups. -->
<full-backup-content>
    <exclude domain="file" path="achievements.json" />
    <exclude domain="file" path="scraping.json" />
    <exclude domain="file" path="launchbox/" />
    <exclude domain="file" path="details-tried.tsv" />
</full-backup-content>
