<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: keep account keys (RetroAchievements, Steam, scraping sources), the Steam achievements cache, the LaunchBox index and its lookup cache, and the Plaza (other people's Bump cards) out of cloud and device backups. -->
<full-backup-content>
    <exclude domain="file" path="achievements.json" />
    <exclude domain="file" path="steam.json" />
    <exclude domain="file" path="steam/" />
    <exclude domain="file" path="scraping.json" />
    <exclude domain="file" path="launchbox/" />
    <exclude domain="file" path="details-tried.tsv" />
    <exclude domain="file" path="plaza.json" />
</full-backup-content>
