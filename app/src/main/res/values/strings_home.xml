    <!-- Settings › Home & play: running games, the Home screen, the screensaver and privacy. -->
    <string name="home_play_title">Home &amp; play</string>
    <string name="home_play_use_home">Use Tandem as the Home screen</string>
    <string name="home_play_use_home_help">Make the Home button bring you to Tandem, like a console. You can switch back to the usual launcher any time.</string>
    <!-- A row's value while the setting can't work without the Shizuku app. -->
    <string name="home_play_needs_shizuku">Needs Shizuku</string>
    <string name="home_play_needs_shizuku_toast">This needs Shizuku running, with Tandem allowed</string>
    <string name="home_play_close_previous">Close previous game</string>
    <string name="home_play_close_previous_help">When you start a different game, the one still running in the background is closed first, so it doesn\'t use memory or battery. Needs Shizuku.</string>
    <string name="home_play_ask_closing">Ask before closing a game</string>
    <string name="home_play_ask_closing_help">When starting a game would close one that\'s still running, Tandem asks first: resume it, or close it and start the new one. Needs Shizuku.</string>
    <string name="home_play_immersion">Immersion mode</string>
    <string name="home_play_immersion_needs">Needs Do Not Disturb access</string>
    <string name="home_play_immersion_help">While a game plays, Do Not Disturb is on: no notification pop-ups, sounds or vibrations, only alarms. It goes back to how it was when you come back to Tandem. Needs Tandem allowed under Do Not Disturb access; with Shizuku, Tandem allows itself.</string>
    <!-- What A does on Immersion mode before Tandem is allowed. -->
    <string name="home_play_immersion_allow">Allow</string>
    <string name="home_play_immersion_on">Immersion mode is on</string>
    <string name="home_play_immersion_come_back">Allow Tandem, then come back</string>
    <string name="home_play_dock">Choose dock apps</string>
    <!-- How many apps are on the dock. -->
    <plurals name="home_play_dock_count">
        <item quantity="one">%1$d apps</item>
        <item quantity="other">%1$d apps</item>
    </plurals>
    <string name="home_play_dock_help">Pick which apps sit on the dock and in what order.</string>
    <string name="home_play_screensaver">Screensaver</string>
    <string name="home_play_screensaver_help">After a while without a button press, your covers drift slowly across a night sky while Pip naps, so nothing burns into the screen. Any button wakes it.</string>
    <!-- A screensaver option: it starts after this many minutes without a button press. -->
    <plurals name="home_play_screensaver_after">
        <item quantity="one">After %1$d min</item>
        <item quantity="other">After %1$d min</item>
    </plurals>
    <string name="home_play_freeze">Pause games in sleep</string>
    <string name="home_play_needs_root">Needs root Shizuku</string>
    <string name="home_play_freeze_help">A minute after the screen goes off, games left open are paused, so the handheld really sleeps instead of draining for an emulator\'s audio. They carry on exactly where they were when you wake it. Needs Shizuku running as root.</string>
    <string name="home_play_needs_root_toast">This needs Shizuku running as root</string>
    <string name="home_play_private">Private mode</string>
    <!-- %1$s is the button combination that shows hidden games, like "L1 + R1 + Select". -->
    <string name="home_play_private_help">Hidden games, folders and systems stay hidden until %1$s and your PIN bring them out, and Tandem stays offline. Turning it off asks for the PIN. While it is off, %1$s turns it on at once.</string>
    <string name="home_play_offline">Offline for hidden games</string>
    <string name="home_play_offline_closes">Until closed</string>
    <string name="home_play_offline_plays">While playing</string>
    <string name="home_play_offline_help">In private mode, airplane mode goes on while a hidden game plays, so nothing in the game can go online. While it plays: back online when you come back to Tandem. Until it closes: still offline while the game is open in the background, where it could sync, until its app has closed or you tuck hidden games away. Airplane mode you turned on yourself stays on. Needs Shizuku.</string>
    <!-- The same, while private mode is off. -->
    <string name="home_play_offline_help_off">In private mode, airplane mode goes on while a hidden game plays, so nothing in the game can go online. While it plays: back online when you come back to Tandem. Until it closes: still offline while the game is open in the background, where it could sync, until its app has closed or you tuck hidden games away. Airplane mode you turned on yourself stays on. Needs Shizuku. Only in private mode.</string>
    <string name="home_play_pin">Private mode PIN</string>
    <string name="home_play_pin_set">Set</string>
    <string name="home_play_pin_not_set">Not set</string>
    <string name="home_play_pin_help">Change the 4 to 6 digit PIN that shows hidden games and turns private mode off. Forgot it? Y on the PIN pad starts a 24-hour wait, then you choose a new one.</string>
