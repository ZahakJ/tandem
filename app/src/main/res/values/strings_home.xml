    <!-- The popup about using Tandem as Android's Home screen. -->
    <string name="home_explainer_done">Tandem is your Home screen now ✨</string>
    <string name="home_explainer_title">Tandem as your Home screen</string>
    <string name="home_explainer_body">Press Home anywhere and you land right back here, with your running game one button away. Your other apps stay in the dock and the All apps drawer. You can switch back any time.</string>
