    <!-- How to set each source up: whether it needs an account, the steps (or notes), and what it sends. -->
    <string name="scrape_guide_no_account">No account needed</string>
    <!-- %1$d is the download's size in MB. -->
    <string name="scrape_guide_lb_1">Tandem downloads LaunchBox\'s free games database once (about %1$d MB, Wi-Fi recommended) and keeps just your systems.</string>
    <string name="scrape_guide_lb_2">Games are looked up on this device. It refreshes once a month, when you scrape on Wi-Fi.</string>
    <string name="scrape_guide_lb_sends">Nothing about your games. Pictures come from images.launchbox-app.com.</string>
    <string name="scrape_guide_ss_account">Free account + developer ID</string>
    <string name="scrape_guide_ss_1">Make a free account at screenscraper.fr.</string>
    <!-- "Demande d'accès à l'API" is the name of a forum section on the French site: keep it in French. -->
    <string name="scrape_guide_ss_2">Ask for API access on their forum (\"Demande d\'accès à l\'API\") to get a developer ID and password. Tandem can\'t ship one.</string>
    <string name="scrape_guide_ss_3">Enter both below. Your own login is optional but gives you a bigger daily quota.</string>
    <string name="scrape_guide_ss_sends">Your login, the developer ID, and each game\'s file name, size, system and checksum.</string>
    <string name="scrape_guide_igdb_account">Free Twitch account</string>
    <string name="scrape_guide_igdb_1">Sign in at dev.twitch.tv/console/apps (Twitch asks for two-factor sign-in first).</string>
    <!-- Register Your Application, Application Integration, Confidential, Client ID, New Secret and Client Secret are
         what Twitch's website calls things, in English. -->
    <string name="scrape_guide_igdb_2">Register Your Application: any name, redirect URL http://localhost, category Application Integration, client type Confidential.</string>
    <string name="scrape_guide_igdb_3">Copy the Client ID, press New Secret, and copy the Client Secret.</string>
    <string name="scrape_guide_igdb_sends">Your client ID and secret (to Twitch) and each game\'s title.</string>
    <string name="scrape_guide_sgdb_account">Free account</string>
    <string name="scrape_guide_sgdb_1">Sign in at steamgriddb.com (with your Steam account).</string>
    <string name="scrape_guide_sgdb_2">Open steamgriddb.com/profile/preferences/api.</string>
    <string name="scrape_guide_sgdb_3">Generate an API key and enter it below.</string>
    <string name="scrape_guide_sgdb_sends">Your API key and each game\'s title.</string>
    <string name="scrape_guide_libretro_1">Always ready. Great for classic systems; it has nothing for Switch, Wii U or PC games.</string>
    <string name="scrape_guide_libretro_sends">Picture names made from each game\'s file name or title.</string>
    <string name="scrape_guide_hltb_1">Uses the same search as the howlongtobeat.com website. It isn\'t an official API, so it can stop working when the site changes; scraping then just skips it.</string>
    <string name="scrape_guide_hltb_2">Times show on the bottom screen.</string>
    <string name="scrape_guide_hltb_sends">Each game\'s title.</string>

