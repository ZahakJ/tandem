<?xml version="1.0" encoding="utf-8"?>
<!-- Stats & trophies (Stats.kt, StatsLibrary.kt, Trophies.kt, PlaySessions.kt) and the trophies themselves
     (data/Trophies.kt). Keys start with stats_, then the tab or feature. See docs/TRANSLATING.md. Play times
     ("3h 20m") are made elsewhere and passed in as %1$s. -->
<resources>
    <!-- The tabs along the top of Stats; L1 and R1 switch between them. Keep them short. -->
    <string name="stats_tab_overview">Overview</string>
    <string name="stats_tab_library">Library</string>
    <string name="stats_tab_trophies">Trophies</string>
    <string name="stats_tab_sessions">Sessions</string>
    <string name="stats_tab_achievements">Achievements</string>
    <!-- The R1 button hint beside the tabs. -->
    <string name="stats_hint_switch_tab">Switch tab</string>

    <!-- Overview, with nothing played yet. The button under it goes back. -->
    <string name="stats_overview_empty">Play something and I\'ll keep count here, all on this device</string>
    <string name="stats_overview_go_back">Go back</string>

    <!-- Overview: the four tiles along the top. Each has a label, a big value and a small line under it. -->
    <string name="stats_tile_total">Total play</string>
    <!-- Under Total play: how many games the time is spread over. -->
    <plurals name="stats_tile_total_across">
        <item quantity="one">across %1$d game</item>
        <item quantity="other">across %1$d games</item>
    </plurals>
    <string name="stats_tile_games">Games played</string>
    <!-- Under Games played: the size of the library. -->
    <plurals name="stats_tile_games_of">
        <item quantity="one">of %1$d in your library</item>
        <item quantity="other">of %1$d in your library</item>
    </plurals>
    <string name="stats_tile_streak">Streak</string>
    <!-- The Streak tile's value before any play is recorded in Tandem. -->
    <string name="stats_tile_streak_new">New</string>
    <!-- The Streak tile's value: days in a row with play. -->
    <plurals name="stats_tile_streak_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>
