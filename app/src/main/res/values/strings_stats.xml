    <string name="stats_tile_said">%1$s: %2$s · %3$s</string>

    <string name="stats_by_system">By system</string>
    <string name="stats_most_played">Most played</string>
    <!-- The box that holds the systems too small for a box of their own: "3 more". -->
    <plurals name="stats_mosaic_more">
        <item quantity="one">%1$d more</item>
        <item quantity="other">%1$d more</item>
    </plurals>
    <!-- In a system's box: its share of all play time, like "42% of your play". -->
    <string name="stats_mosaic_share">%1$d%% of your play</string>

    <!-- Overview: Pip's one-line fact about when you play the most. -->
    <string name="stats_fact_morning">You\'re an early bird: most of your play happens in the morning.</string>
    <string name="stats_fact_afternoon">Afternoon adventurer: that\'s when you play the most.</string>
    <string name="stats_fact_evening">Evenings are your game time. Cosy!</string>
    <string name="stats_fact_night">A true night owl. Most of your play is after 11 PM.</string>
    <!-- Pressing the fact. -->
    <string name="stats_fact_private">Your stats never leave this device</string>

