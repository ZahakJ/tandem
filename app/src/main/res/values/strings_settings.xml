<!-- Settings: its pages and groups (SettingsCatalog.kt), the frame every row is drawn in (Settings.kt, Choices.kt),
     the first screen (SettingsHome.kt), search (SettingsSearch.kt) and the side panel's showcases (Showcase.kt).
     Keys start with settings_. See docs/TRANSLATING.md. Page, group and row names sit on one line: keep them about
     as short as the English. -->
<resources>
    <!-- The seven pages: their tiles on the first Settings screen, their titles, and the top bar. -->
    <string name="settings_page_look">Look &amp; feel</string>
    <string name="settings_page_home">Home &amp; layout</string>
    <string name="settings_page_screens">Two screens</string>
    <string name="settings_page_sound">Sound &amp; music</string>
    <string name="settings_page_controls">Controls</string>
