    <string name="settings_about_help">Free and open source (GPL-3.0). No ads, no accounts, no tracking. Your data stays on your device.</string>
    <string name="settings_about_hi">Made with love, free forever. Hi from Pip!</string>
    <string name="settings_updates">Updates</string>
    <!-- %1$s is this version, like "0.8.0"; %2$s is settings_about_help. "Update" names the button that installs. -->
    <string name="settings_updates_help">This is Tandem %1$s. A asks GitHub whether a newer one is out. Update downloads it, checks it is the real release (its checksum and Tandem\'s signing key) and installs it; Tandem restarts. With Shizuku it installs without a question; otherwise Android asks once to allow installs from Tandem. %2$s</string>
