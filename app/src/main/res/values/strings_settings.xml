    <string name="settings_page_play">Play &amp; system</string>

    <!-- What each page holds, in a sentence (the side panel beside its tile). -->
    <string name="settings_page_look_blurb">Themes and theme packs, colours, wallpapers, system icons, motion and the language.</string>
    <string name="settings_page_home_blurb">Your home layout and its screen, how games show inside a system, the dock and widgets, the clock and the screensaver.</string>
    <string name="settings_page_screens_blurb">What each screen shows, while you browse and while you play: one screen or two, swapping them, the other screen\'s art, and moving apps between them.</string>
    <string name="settings_page_sound_blurb">The theme pack\'s own music and sounds, UI sounds, Pip\'s voice, and your music or the built-in soundtrack.</string>
    <string name="settings_page_controls_blurb">Button prompts, swapping A/B and X/Y, rebinding any button, your controllers and the Deck.</string>
    <string name="settings_page_library_blurb">Game folders, rescanning and sorting, systems and emulators, artwork and its sources, and your RetroAchievements and Steam accounts.</string>
    <!-- The same, in builds with Discord. -->
    <string name="settings_page_library_blurb_discord">Game folders, rescanning and sorting, systems and emulators, artwork and its sources, and your RetroAchievements, Steam and Discord accounts.</string>
    <string name="settings_page_play_blurb">Resuming and closing games, performance, privacy and hidden games, backups, Tandem as your Home screen, and updates.</string>

