    <string name="settings_library_hidden_private">Private</string>
    <string name="settings_library_hidden_help">Games, folders and systems you hid with Y stay out of sight unless this is on; then they show, dimmed. Start › Hidden lists everything hidden, each with Unhide. In private mode it asks for your PIN.</string>
    <string name="settings_library_rescan">Rescan games</string>
