<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The bottom-screen companion: no starting window or splash, no open/close animation (it fades itself in). -->
    <style name="Tandem.Companion" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- MainActivity: its starting window is the last theme's backdrop colour (StartLook.kt), edge to edge and
         without bars from the first frame. values-v31 adds the Android 12+ splash attributes (no icon). -->
    <style name="Tandem.Start" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="android:windowBackground">@color/start_night</item>
        <item name="android:statusBarColor">@color/start_night</item>
        <item name="android:navigationBarColor">@color/start_night</item>
    </style>

    <!-- The same in other themes' colours (StartLook.STYLES). -->
    <style name="Tandem.Start.Black"><item name="android:windowBackground">@color/start_black</item><item name="android:statusBarColor">@color/start_black</item><item name="android:navigationBarColor">@color/start_black</item></style>
    <style name="Tandem.Start.Navy"><item name="android:windowBackground">@color/start_navy</item><item name="android:statusBarColor">@color/start_navy</item><item name="android:navigationBarColor">@color/start_navy</item></style>
    <style name="Tandem.Start.Violet"><item name="android:windowBackground">@color/start_violet</item><item name="android:statusBarColor">@color/start_violet</item><item name="android:navigationBarColor">@color/start_violet</item></style>
    <style name="Tandem.Start.Slate"><item name="android:windowBackground">@color/start_slate</item><item name="android:statusBarColor">@color/start_slate</item><item name="android:navigationBarColor">@color/start_slate</item></style>
    <style name="Tandem.Start.Green"><item name="android:windowBackground">@color/start_green</item><item name="android:statusBarColor">@color/start_green</item><item name="android:navigationBarColor">@color/start_green</item></style>
    <style name="Tandem.Start.Warm"><item name="android:windowBackground">@color/start_warm</item><item name="android:statusBarColor">@color/start_warm</item><item name="android:navigationBarColor">@color/start_warm</item></style>
    <style name="Tandem.Start.Cream"><item name="android:windowBackground">@color/start_cream</item><item name="android:statusBarColor">@color/start_cream</item><item name="android:navigationBarColor">@color/start_cream</item></style>
    <style name="Tandem.Start.Blush"><item name="android:windowBackground">@color/start_blush</item><item name="android:statusBarColor">@color/start_blush</item><item name="android:navigationBarColor">@color/start_blush</item></style>
    <style name="Tandem.Start.Lime"><item name="android:windowBackground">@color/start_lime</item><item name="android:statusBarColor">@color/start_lime</item><item name="android:navigationBarColor">@color/start_lime</item></style>
</resources>
