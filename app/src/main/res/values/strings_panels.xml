<?xml version="1.0" encoding="utf-8"?>
<!-- The panels: Start (StartPanel.kt), the quick settings (QuickPanel.kt) and the side panel (SidePanel.kt).
     Keys start with panels_, then the panel. See docs/TRANSLATING.md. Labels sit on one line in a narrow panel: keep
     them as short as the English. -->
<resources>
    <!-- Start: the button hints. -->
    <string name="panels_start_hint_unhide">Unhide</string>
    <string name="panels_start_hint_hide_again">Hide again</string>
    <string name="panels_start_hint_show_here">Show here</string>

    <!-- Start: the main page. -->
    <string name="panels_start_switch_games">Switch games</string>
    <string name="panels_start_all_apps">All apps</string>
    <string name="panels_start_search">Search</string>
    <string name="panels_start_stats">Stats &amp; trophies</string>
    <string name="panels_start_new">New</string>
    <string name="panels_start_sort">Sort</string>
    <string name="panels_start_edit_grid">Edit grid</string>
    <string name="panels_start_undo">Undo</string>
    <string name="panels_start_edit_widgets">Edit widgets</string>
    <string name="panels_start_hidden">Hidden</string>
    <string name="panels_start_settings">Settings</string>
    <!-- Start: the row that puts the home in try-on mode, where L1 / R1 put on each home layout live (LayoutSwitch.kt); the one in use is named beside it. -->
    <string name="panels_start_layout">Layout</string>
    <!-- Trying layouts (Start › Layout): the hints in the pill along the top. Keep them short. A keeps the layout on screen, B puts back the one before; "Size: %1$s" follows L2 / R2, which change the layout's size (%1$s is "Large", "Systems only", "Left"...). -->
    <string name="panels_layout_hint_size">Size: %1$s</string>
    <string name="panels_layout_hint_keep">Keep</string>
    <string name="panels_layout_hint_cancel">Cancel</string>
    <!-- Trying layouts, on the other screen's button pill: beside L1 R1, which put on the layout before or after. -->
    <string name="panels_layout_hint_layout">Layout</string>
    <!-- Beside L2 R2 on the same pill: the tried layout's size, smaller or bigger. -->
    <string name="panels_layout_hint_size_plain">Size</string>
    <!-- A new version of Tandem: "Tandem 0.8.0 is out". -->
    <string name="panels_start_update">Tandem %1$s is out</string>
    <!-- Beside Stats & trophies: how many trophies are earned. -->
    <plurals name="panels_start_trophies">
        <item quantity="one">%1$d trophy</item>
        <item quantity="other">%1$d trophies</item>
    </plurals>
    <!-- Beside Stats & trophies, before the first trophy: how many games have the status Playing. -->
    <plurals name="panels_start_playing">
        <item quantity="one">%1$d playing</item>
        <item quantity="other">%1$d playing</item>
    </plurals>

