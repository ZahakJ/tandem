    <string name="look_highlight_help">How the highlighted card is marked: a soft glow, a crisp outline, a lift with a big shadow, or a gently pulsing ring.</string>
    <string name="look_surface">Surface</string>
    <string name="look_surface_help">What cards are made of: solid, frosted glass that lets the wallpaper glow through, or light outlines.</string>

    <string name="look_icon_style">Icon style</string>
    <string name="look_icon_style_help">How Tandem draws system icons when a theme pack doesn\'t bring its own: a little device of the right kind with the system\'s name, as glossy bubbles, neon tubes, pixels, LCD, chrome and more.</string>
    <string name="look_icons_from">Icons from</string>
    <string name="look_icons_from_help">Use a pack\'s system icons, heroes and logos with any theme, or always draw them. Auto uses the theme pack\'s own art; with a built-in theme it borrows the first Cocoon smart-folder pack in ROMs/assets/smart_folders. Drawn by Tandem shows the theme\'s icon style.</string>
    <!-- Icons from options; the others are the names of installed packs. -->
    <string name="look_icons_from_auto">Auto</string>
    <string name="look_icons_from_drawn">Drawn by Tandem</string>

    <string name="look_animation">Animation style</string>
    <string name="look_animation_help">Bouncy is playful, Smooth glides without overshoot, Minimal is quick and subtle, Off changes things instantly.</string>
    <string name="look_reduce_motion">Reduce motion</string>
    <string name="look_reduce_motion_help">Turns off moving wallpapers, panning art and bouncy animations everywhere. Battery saver does the same for wallpapers.</string>

    <!-- Wallpaper: Top screen and Bottom screen offer the backdrops (look_backdrop_…), these two and the user's own files. -->
