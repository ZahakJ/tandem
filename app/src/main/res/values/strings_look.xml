    <string name="look_wall_top">Top screen</string>
    <string name="look_wall_top_help">An animated backdrop, the highlighted game\'s art, or your own picture or video: copy pictures (PNG, JPG, WebP) or videos (MP4, WebM) into ROMs/tandem/wallpapers and they show up here.</string>
    <string name="look_wall_bottom">Bottom screen</string>
    <string name="look_wall_bottom_help">The same choices for the second screen. Game art and videos look great down there.</string>
    <string name="look_wall_dim">Picture dimming</string>
    <string name="look_wall_dim_help">Darkens picture and video wallpapers so text on top stays easy to read.</string>

    <string name="look_games_view">Games view</string>
    <string name="look_games_view_help">How games show inside a system or collection: a grid of cards, a list with details (great for big libraries), a coverflow, spines on a bookshelf, or cartridges in a case.</string>
    <string name="look_games_grid_size">Grid size</string>
    <string name="look_games_grid_size_help">How big game cards are in a system, or a fixed number of columns.</string>
    <string name="look_games_card_shape">Card shape</string>
    <string name="look_games_card_shape_help">Rounded, square, circle, tall box-art cards, or wide cards for screenshots and banners.</string>
    <string name="look_games_shelf_look">Shelf look</string>
    <string name="look_games_shelf_look_help">The bookcase behind the Shelf view of a folder: warm wood, matte boards in the theme\'s colours, or open, with the cases on your wallpaper and only a thin shelf line.</string>
    <string name="look_games_titles">Game titles</string>
    <string name="look_games_titles_help">Write each game\'s name under its card.</string>
    <string name="look_home_system_tiles">System tiles</string>
    <string name="look_home_system_tiles_help">The look of the system tiles on the home screen.</string>
    <string name="look_home_rows">Home rows</string>
    <string name="look_home_rows_help">Which rows the home screen shows, and in what order.</string>
    <string name="look_home_open_folders">Open folders</string>
    <string name="look_home_open_folders_help">As a page, as a fullscreen page (the top bar slides away so the grid gets the whole screen), or as a popup over the screen you\'re on.</string>
    <string name="look_home_open_folders_page">Page</string>
    <string name="look_home_open_folders_fullscreen">Fullscreen</string>
    <string name="look_home_open_folders_popup">Popup</string>
    <string name="look_home_now_playing">Now playing</string>
    <string name="look_home_now_playing_help">While a game runs in the background, show it at the top of the home screen so you can jump back in.</string>
    <string name="look_corner_hints">Corner hints</string>
    <string name="look_corner_hints_help">A small reminder of the buttons in the corner of the top screen.</string>

    <string name="look_dock_apps">Apps dock</string>
    <string name="look_dock_apps_help">Your favourite Android apps on the home screen. Press Y on one to move or remove it.</string>
    <string name="look_dock_style">Dock style</string>
    <string name="look_dock_style_help">A floating bar, a full-width shelf, or just the icons. Applies to every layout except Shelves.</string>
    <string name="look_dock_top">Dock on top</string>
    <string name="look_dock_top_help">Put the dock above the tiles instead of below them.</string>
    <string name="look_dock_auto_hide">Auto-hide dock</string>
    <string name="look_dock_auto_hide_help">The dock stays small and faded until you move into it.</string>

    <!-- The bottom screen's style while you browse (Two screens › Other screen). -->
    <string name="look_bottom_style">Style</string>
    <string name="look_bottom_style_help">Details shows the game\'s art fading into its info. Art + info lets the moving art fill the screen with info on top. Animated art is pure eye candy. Clock keeps it calm.</string>
    <string name="look_bottom_logo_size">Logo size</string>
    <string name="look_bottom_logo_size_help">The size of the game\'s logo over its art.</string>
    <string name="look_bottom_art_fade">Art fade</string>
    <string name="look_bottom_art_fade_help">How the art blends into the background below it.</string>
    <string name="look_bottom_video_snaps">Video snaps</string>
    <string name="look_bottom_video_snaps_help">Plays a game\'s video (from ROMs/downloaded_media/&lt;system&gt;/videos) after you rest on it. Fast starts sooner; Saver waits longer so quick scrolling never decodes video. Always muted, and stopped while you play.</string>
