    <string name="look_accent">لون التمييز</string>
    <string name="look_accent_help">لون تمييز خاص بك لمفاتيح التبديل والتحديد. جرّب الألوان باليمين واليسار؛ والزر A يعرضها كلها، و«اكتب لونًا…» يقبل أي لون، مثل #FF7AB6.</string>
    <string name="look_accent_theme">السمة</string>
    <string name="look_accent_type">اكتب لونًا…</string>
    <string name="look_accent_hex">لون التمييز (hex)</string>
    <string name="look_accent_bad">هذا لا يبدو لونًا</string>
    <string name="look_highlight">شكل التحديد</string>
    <string name="look_highlight_help">كيف تتميّز البطاقة المحدّدة: توهّج ناعم، أو إطار حادّ، أو ارتفاع بظل كبير، أو حلقة تنبض بلطف.</string>
    <string name="look_surface">الملمس</string>
    <string name="look_surface_help">مِمَّ صُنعت البطاقات: مصمتة، أو زجاج مُغبَّش يتسلّل منه ضوء الخلفية، أو إطارات خفيفة.</string>

    <string name="look_icon_style">شكل الأيقونات</string>
    <string name="look_icon_style_help">كيف يرسم Tandem أيقونات المنصّات حين لا تأتي حزمة السمة بأيقوناتها: جهاز صغير من النوع الصحيح عليه اسم المنصّة، على هيئة فقاعات لامعة، أو أنابيب نيون، أو بكسلات، أو LCD، أو كروم، وغيرها.</string>
    <string name="look_icons_from">مصدر الأيقونات</string>
    <string name="look_icons_from_help">استخدم أيقونات المنصّات والصور البارزة والشعارات من حزمة ما مع أي سمة، أو ارسمها دائمًا. «تلقائي» يستخدم صور حزمة السمة نفسها؛ ومع سمة مدمجة يستعير أول حزمة مجلدات ذكية من Cocoon في ROMs/assets/smart_folders. و«يرسمها Tandem» يعرض شكل أيقونات السمة.</string>
    <string name="look_icons_from_auto">تلقائي</string>
    <string name="look_icons_from_drawn">يرسمها Tandem</string>

    <string name="look_animation">أسلوب الحركة</string>
    <string name="look_animation_help">«نطّاط» مرِح، و«انسيابي» ينزلق بلا ارتداد، و«خفيف» سريع وهادئ، و«بلا حركة» يغيّر كل شيء في لحظة.</string>
    <string name="look_reduce_motion">تقليل الحركة</string>
    <string name="look_reduce_motion_help">يوقف الخلفيات المتحرّكة والصور المنسابة والحركات النطّاطة في كل مكان. وتوفير شحن البطارية يفعل الشيء نفسه مع الخلفيات.</string>

    <string name="look_wall_theme">خلفية السمة</string>
    <string name="look_wall_hero">صورة اللعبة (مموّهة)</string>
    <string name="look_wall_top">الشاشة العلوية</string>
    <string name="look_wall_top_help">خلفية متحرّكة، أو صورة اللعبة المحدّدة، أو صورة أو فيديو من عندك: انسخ الصور (PNG وJPG وWebP) أو الفيديوهات (MP4 وWebM) إلى ROMs/tandem/wallpapers وستظهر هنا.</string>
    <string name="look_wall_bottom">الشاشة السفلية</string>
    <string name="look_wall_bottom_help">الخيارات نفسها للشاشة الثانية. صور الألعاب والفيديوهات تبدو رائعة هناك في الأسفل.</string>
    <string name="look_wall_dim">تعتيم الصور</string>
    <string name="look_wall_dim_help">يعتّم خلفيات الصور والفيديو ليبقى النص فوقها سهل القراءة.</string>

    <string name="look_games_view">عرض الألعاب</string>
    <string name="look_games_view_help">كيف تظهر الألعاب داخل المنصّة أو المجموعة: شبكة بطاقات، أو قائمة بالتفاصيل (رائعة للمكتبات الكبيرة)، أو عرض دوّار، أو كعوب على رف، أو خراطيش في علبة.</string>
    <string name="look_games_grid_size">حجم الشبكة</string>
    <string name="look_games_grid_size_help">حجم بطاقات الألعاب داخل المنصّة، أو عدد ثابت من الأعمدة.</string>
    <string name="look_games_card_shape">شكل البطاقة</string>
    <string name="look_games_card_shape_help">مستديرة الزوايا، أو مربعة، أو دائرية، أو طويلة بحجم الغلاف، أو عريضة للقطات الشاشة واللافتات.</string>
    <string name="look_games_shelf_look">شكل الرف</string>
    <string name="look_games_shelf_look_help">خزانة الرفوف خلف عرض «الرف» في المجلد: خشب دافئ، أو ألواح غير لامعة بألوان السمة، أو مفتوحة تقف فيها العلب على خلفيتك مع خط رف رفيع فقط.</string>
    <string name="look_games_titles">أسماء الألعاب</string>
    <string name="look_games_titles_help">اسم كل لعبة مكتوبًا تحت بطاقتها.</string>
    <string name="look_home_system_tiles">مربعات المنصّات</string>
    <string name="look_home_system_tiles_help">شكل مربعات المنصّات على الشاشة الرئيسية.</string>
    <string name="look_home_rows">صفوف الرئيسية</string>
    <string name="look_home_rows_help">الصفوف التي تعرضها الشاشة الرئيسية، وبأي ترتيب.</string>
    <string name="look_home_open_folders">فتح المجلدات</string>
    <string name="look_home_open_folders_help">كصفحة، أو كصفحة بملء الشاشة (ينزلق الشريط العلوي بعيدًا لتأخذ الشبكة الشاشة كلها)، أو كنافذة منبثقة فوق الشاشة التي أنت فيها.</string>
    <string name="look_home_open_folders_page">صفحة</string>
    <string name="look_home_open_folders_fullscreen">ملء الشاشة</string>
    <string name="look_home_open_folders_popup">منبثقة</string>
    <string name="look_home_now_playing">قيد اللعب الآن</string>
    <string name="look_home_now_playing_help">حين تعمل لعبة في الخلفية، اعرضها أعلى الشاشة الرئيسية لتعود إليها بضغطة.</string>
    <string name="look_corner_hints">تلميحات الزاوية</string>
    <string name="look_corner_hints_help">تذكير صغير بالأزرار في زاوية الشاشة العلوية.</string>

    <string name="look_dock_apps">شريط التطبيقات</string>
    <string name="look_dock_apps_help">تطبيقات Android المفضّلة لديك على الشاشة الرئيسية. اضغط Y على أحدها لنقله أو إزالته.</string>
    <string name="look_dock_style">شكل الشريط</string>
    <string name="look_dock_style_help">شريط عائم، أو رف بعرض الشاشة، أو الأيقونات وحدها. يسري على كل التخطيطات ما عدا «الرفوف».</string>
    <string name="look_dock_top">الشريط في الأعلى</string>
    <string name="look_dock_top_help">ضع الشريط فوق المربعات بدل أسفلها.</string>
    <string name="look_dock_auto_hide">إخفاء الشريط تلقائيًا</string>
    <string name="look_dock_auto_hide_help">يبقى الشريط صغيرًا باهتًا حتى تنتقل إليه.</string>

    <string name="look_bottom_style">النمط</string>
    <string name="look_bottom_style_help">«التفاصيل» تعرض صورة اللعبة تذوب في معلوماتها. و«صورة + معلومات» تدع الصورة المتحرّكة تملأ الشاشة والمعلومات فوقها. و«صورة متحرّكة» متعة للعين فقط. و«الساعة» تُبقي الأجواء هادئة.</string>
    <string name="look_bottom_logo_size">حجم الشعار</string>
    <string name="look_bottom_logo_size_help">حجم شعار اللعبة فوق صورتها.</string>
    <string name="look_bottom_art_fade">تلاشي الصورة</string>
    <string name="look_bottom_art_fade_help">كيف تذوب الصورة في الخلفية تحتها.</string>
    <string name="look_bottom_video_snaps">لقطات الفيديو</string>
    <string name="look_bottom_video_snaps_help">يشغّل فيديو اللعبة (من ROMs/downloaded_media/&lt;system&gt;/videos) بعد أن تتوقف عندها. «سريع» يبدأ أبكر؛ و«موفّر» ينتظر أطول كي لا يُفكّ ترميز أي فيديو وأنت تمرّ بسرعة. صامت دائمًا، ويتوقف وأنت تلعب.</string>
    <string name="look_bottom_video_snaps_fast">سريع</string>
    <string name="look_bottom_video_snaps_balanced">متوازن</string>
    <string name="look_bottom_video_snaps_saver">موفّر</string>
    <string name="look_bottom_moving_art">صور متحرّكة</string>
    <string name="look_bottom_moving_art_help">صورة اللعبة تنساب وتقترب ببطء، كملصق ينبض بالحياة.</string>

    <string name="look_top_battery">البطارية</string>
    <string name="look_top_battery_help">اعرض نسبة البطارية بجانب الساعة.</string>
    <string name="look_top_clock">الساعة</string>
    <string name="look_top_clock_help">نظام 12 ساعة، أو 24 ساعة، أو ما يستخدمه النظام، أو بلا ساعة أصلًا.</string>
    <string name="look_top_clock_system">النظام</string>
    <string name="look_top_clock_12">12 ساعة</string>
    <string name="look_top_clock_24">24 ساعة</string>
    <string name="look_top_clock_hidden">مخفية</string>

    <string name="look_controls_prompts">رموز الأزرار</string>
    <string name="look_controls_prompts_help">كيف تُرسم الأزرار في التلميحات: بألوان Tandem الباستيلية، أو على طريقة Xbox أو PlayStation أو Nintendo.</string>
    <string name="look_controls_swap_ab">تبديل A وB</string>
    <string name="look_controls_swap_ab_help">التأكيد بالزر B والرجوع بالزر A، كما في أجهزة Nintendo. وتتغيّر التلميحات تبعًا لذلك.</string>
    <string name="look_controls_swap_xy">تبديل X وY</string>
    <string name="look_controls_swap_xy_help">البحث بالزر Y، والخيارات بالزر X.</string>
    <string name="look_controls_does_open">فتح</string>
    <string name="look_controls_does_search">بحث</string>
    <string name="look_controls_does_options">خيارات</string>
    <string name="look_controls_rebind">إعادة تعيين الأزرار</string>
    <string name="look_controls_rebind_help">أعطِ أي أمر من أوامر Tandem زرًا آخر، أو تركيبة أزرار تُضغط معًا، أو ضغطة مطوّلة: الفتح، والرجوع، وقائمة الخيارات، وStart، والإعدادات السريعة، ومبدّل الألعاب، واللوحة الجانبية، وتقليب الصفحات، والألعاب المخفية، وزرًا للمفضّلة ولقطة الشاشة والمقطع. وتتغيّر التلميحات في كل مكان تبعًا لذلك.</string>
    <string name="look_controls_rebind_defaults">الافتراضي</string>
    <plurals name="look_controls_rebind_changes">
        <item quantity="zero">لا تغييرات</item>
        <item quantity="one">تغيير واحد</item>
        <item quantity="two">تغييران</item>
        <item quantity="few">%1$d تغييرات</item>
        <item quantity="many">%1$d تغييرًا</item>
        <item quantity="other">%1$d تغيير</item>
    </plurals>

    <string name="look_screens_swap">تبديل الشاشتين</string>
    <string name="look_screens_swap_help">تنتقل المكتبة إلى الشاشة السفلية (اللمسية) وتصعد التفاصيل إلى الأعلى، في لحظة. والزر X يفعل ذلك على شبكة الأيقونات. وتبقى الألعاب تُفتح على الشاشة العلوية.</string>
    <string name="look_screens_rotation">إبقاء التدوير التلقائي معطّلًا</string>
    <string name="look_screens_rotation_help">جهاز Thor يعيد تفعيل التدوير التلقائي من تلقاء نفسه بين حين وآخر، وTandem يعطّله من جديد كلما عدت إليه. عطّل هذا الخيار لتقرّر بنفسك.</string>

    <string name="look_reset">إعادة ضبط المظهر</string>
    <string name="look_reset_help">العودة إلى مظهر Tandem الأصلي: السمة، والتخطيط، والخلفيات، والأيقونات، والحركة. أزرارك وشاشاتك وأصواتك وموسيقاك ومكتبتك ومفضّلتك ووقت لعبك لا يمسّها شيء.</string>
    <string name="look_reset_ask">إعادة ضبط المظهر كله؟</string>
    <string name="look_reset_ask_body">تعود السمة والتخطيط والخلفيات والأيقونات والحركة إلى ما كانت عليه أول مرة. الأزرار والشاشات والصوت والألعاب تبقى كما هي.</string>
