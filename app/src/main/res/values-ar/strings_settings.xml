    <string name="settings_sub_wallpaper">الخلفية</string>
    <string name="settings_sub_wallpaper_help">خلفية كل شاشة، ومقدار تعتيم الصور والفيديوهات.</string>
    <string name="settings_sub_motion">الحركة</string>
    <string name="settings_sub_motion_help">كيف تتحرّك الأشياء: أسلوب الحركة، وتقليل الحركة، والعناوين الطائرة، ومدى حيويتها، وطريقة تبادل الشاشتين.</string>
    <string name="settings_sub_icons_help">شكل المنصّات في كل مكان: شكل الأيقونات التي يرسمها Tandem، والحزمة التي تأتي منها الصور، ومجموعات الصور التي يرسمها Tandem بنفسه.</string>
    <string name="settings_sub_grid">شكل الشبكة</string>
    <string name="settings_sub_grid_help">صفوف شبكة الأيقونات، واستدارة أيقوناتها، والمسافة بينها، والصور فوق الشبكة.</string>
    <string name="settings_sub_games">عرض الألعاب</string>
    <string name="settings_sub_games_help">كيف تظهر الألعاب داخل المنصّة أو المجموعة: طريقة العرض وحجمها، وشكل البطاقة، وخزانة الرفوف والعناوين.</string>
    <string name="settings_sub_dock">الشريط والأدوات</string>
    <string name="settings_sub_dock_help">شريط التطبيقات على الرئيسية، والأدوات التي يحملها.</string>
    <string name="settings_sub_art">الصور والفيديو</string>
    <string name="settings_sub_art_help">الصور على الشاشة الأخرى: لقطات الفيديو، والصور المتحرّكة، وحجم الشعار، وطريقة تلاشي الصورة.</string>
    <string name="settings_sub_pads">أذرع التحكّم المتصلة</string>
    <string name="settings_sub_pads_help">أذرع التحكّم عبر البلوتوث وUSB: تسميات أزرار Nintendo لكل منها، وما يفعله زر Home فيها.</string>
    <string name="settings_sub_deck">لوحة اللمس</string>
    <string name="settings_sub_deck_help">لوحة اللمس: لوحة المفاتيح ولوحة التتبّع على الشاشة السفلية، لألعاب الكمبيوتر والبث.</string>
    <string name="settings_sub_accounts">الحسابات</string>
    <string name="settings_sub_accounts_help">إنجازات RetroAchievements وSteam، وحالتك على Discord.</string>
    <string name="settings_sub_perf">الأداء والسكون</string>
    <string name="settings_sub_perf_help">وضع الأداء والمروحة ومعدّل التحديث أثناء اللعب، وإيقاف الألعاب مؤقتًا حين ينام الجهاز.</string>
    <string name="settings_sub_privacy">الخصوصية والمخفي</string>
    <string name="settings_sub_privacy_help">الوضع الخاص ورمز PIN الخاص به، وإظهار الألعاب المخفية، وقطع الاتصال بالإنترنت أثناء لعب لعبة مخفية.</string>
    <string name="settings_sub_data">بياناتك</string>
    <string name="settings_sub_data_help">النسخ الاحتياطي والاستعادة، وجلب إعدادات Cocoon وتفاصيل gamelist.xml، وتصدير إحصاءات لعبك.</string>
    <string name="settings_sub_dev">لهواة العبث</string>
    <string name="settings_sub_dev_help">أدوات لقياس السلاسة وتجربة السمات. لن تحتاج إليها، على الأغلب.</string>

