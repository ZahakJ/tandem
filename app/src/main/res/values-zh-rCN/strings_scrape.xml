    <string name="scrape_guide_no_account">无需账号</string>
    <string name="scrape_guide_lb_1">Tandem 会下载一次 LaunchBox 的免费游戏数据库（约 %1$d MB，建议用 Wi-Fi），只保留你有的平台。</string>
    <string name="scrape_guide_lb_2">游戏在本机上查找。每月在 Wi-Fi 下刮削时更新一次。</string>
    <string name="scrape_guide_lb_sends">不发送你游戏的任何信息。图片来自 images.launchbox-app.com。</string>
    <string name="scrape_guide_ss_account">免费账号 + 开发者 ID</string>
    <string name="scrape_guide_ss_1">在 screenscraper.fr 注册一个免费账号。</string>
    <string name="scrape_guide_ss_2">在他们的论坛（“Demande d\'accès à l\'API”）申请 API 权限，拿到开发者 ID 和密码。Tandem 没法内置一个。</string>
    <string name="scrape_guide_ss_3">把两者都填在下面。你自己的登录信息是可选的，但能让每日额度更多。</string>
    <string name="scrape_guide_ss_sends">你的登录信息、开发者 ID，以及每款游戏的文件名、大小、平台和校验和。</string>
    <string name="scrape_guide_igdb_account">免费 Twitch 账号</string>
    <string name="scrape_guide_igdb_1">在 dev.twitch.tv/console/apps 登录（Twitch 会先要求开启两步验证）。</string>
    <string name="scrape_guide_igdb_2">点 Register Your Application：名称随意，OAuth 重定向网址填 http://localhost，类别选 Application Integration，客户端类型选 Confidential。</string>
    <string name="scrape_guide_igdb_3">复制 Client ID，点 New Secret，再复制 Client Secret。</string>
    <string name="scrape_guide_igdb_sends">你的客户端 ID 和密钥（发给 Twitch），以及每款游戏的标题。</string>
    <string name="scrape_guide_sgdb_account">免费账号</string>
    <string name="scrape_guide_sgdb_1">在 steamgriddb.com 登录（用你的 Steam 账号）。</string>
    <string name="scrape_guide_sgdb_2">打开 steamgriddb.com/profile/preferences/api。</string>
    <string name="scrape_guide_sgdb_3">生成一个 API 密钥，填在下面。</string>
    <string name="scrape_guide_sgdb_sends">你的 API 密钥和每款游戏的标题。</string>
