    <string name="sound_pack_modern">现代</string>
    <string name="sound_pack_modern_blurb">柔和的轻触声和温和的音调，短促安静，就像当下的游戏主机。Tandem 的招牌音效。</string>
    <string name="sound_pack_playful">欢快</string>
    <string name="sound_pack_playful_blurb">清脆的马林巴琴和温暖的风铃声：Tandem 最初的那套开心音效。</string>
    <string name="sound_pack_chiptune">芯片音乐</string>
    <string name="sound_pack_chiptune_blurb">方波“哔哔”声和顶出金币时的欢快音效，就像 8 位机。</string>
    <string name="sound_pack_bubbly">泡泡</string>
    <string name="sound_pack_bubbly_blurb">圆润的水滴“啵”声和冒泡的闪光音。</string>
    <string name="sound_pack_minimal">极简</string>
    <string name="sound_pack_minimal_blurb">安静、短促、低调。几乎听不见。</string>
    <string name="sound_pack_studio">录音棚</string>
    <string name="sound_pack_studio_blurb">毛毡与木头：低沉温暖的敲击，带一点柔软的回弹，像一把做工精良的键盘。</string>
    <string name="sound_pack_thock">麻将音</string>
    <string name="sound_pack_thock_blurb">低沉、厚实的“麻将音”，像一把好轴体的机械键盘。</string>
    <string name="sound_pack_glass">玻璃</string>
    <string name="sound_pack_glass_blurb">干净明亮的水晶音色，余音稍长。清脆又精致。</string>
    <string name="sound_pack_air">空气</string>
    <string name="sound_pack_air_blurb">轻柔的气息和纯净圆润的音色。平静而开阔。</string>

    <string name="sound_mood_still_water">黄昏时分，静谧湖面上的轻柔钢琴</string>
    <string name="sound_mood_soft_morning">晨光洒进来时的竖琴与钢片琴</string>
    <string name="sound_mood_hillside_breeze">阳光与风中的山坡上，长笛与钢琴</string>
    <string name="sound_mood_lantern_town">灯火小镇里的一支手风琴圆舞曲</string>
    <string name="sound_mood_seaside_train">沿海岸行驶的小火车，窗外是海浪</string>
    <string name="sound_mood_forest_spirits">小精灵们在古树之间起舞</string>
    <string name="sound_mood_summer_rain">慵懒夏日午后的钢琴与细雨</string>
    <string name="sound_mood_flying_home">在回家的路上，飞越田野</string>
    <string name="sound_mood_plaza">阳光小广场上，口哨与马林巴</string>
    <string name="sound_mood_shop">尼龙弦吉他配波萨诺瓦，慢慢逛货架</string>
    <string name="sound_mood_lounge">安静时光里的八音盒圆舞曲</string>
    <string name="sound_mood_passby">好消息来啦，一小段欢快的旋律</string>
