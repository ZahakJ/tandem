    <string name="whatsnew_090_tagline">抬一抬，试一试，滑一滑</string>

    <string name="whatsnew_090_lift_title">按 Y 抬起来</string>
    <string name="whatsnew_090_lift_body">在图块上按 Y，它会原地抬起，旁边出现“打开”和“编辑”。长按 Y 就能拿起来挪动。在空位上按 Y，“新建”“排序”“搜索”都在手边。</string>
    <string name="whatsnew_090_lift_short">按 Y 抬起</string>

    <string name="whatsnew_090_edit_title">每个图块都随你改</string>
    <string name="whatsnew_090_edit_body">编辑合成了一个界面：外观、选项、整理，还带实时预览。图标、主视觉图和标志都能换成你自己的图片（GIF 还会动！），每个图块的圆角也能单独调。</string>
    <string name="whatsnew_090_edit_short">编辑与上传</string>

    <string name="whatsnew_090_tryon_title">布局随便试穿</string>
    <string name="whatsnew_090_tryon_body">Start › 布局 会把每种布局直接套在你的主页上。L1 和 R1 切换，A 保留，B 一键还原。</string>
    <string name="whatsnew_090_tryon_short">试穿布局</string>

    <string name="whatsnew_090_stage_title">登上舞台</string>
    <string name="whatsnew_090_stage_body">全新布局：每个平台或合集一页，游戏美图铺满整排游戏的背后。L1 和 R1 左右翻页。</string>
    <string name="whatsnew_090_stage_short">舞台</string>

    <string name="whatsnew_090_glide_title">一路丝滑</string>
    <string name="whatsnew_090_glide_body">在任何布局里，L1 和 R1 都能在分组间跳转，小条会告诉你落在哪儿。选中框在图标间顺滑滑动，“继续游玩”卡片打头阵。</string>
    <string name="whatsnew_090_glide_short">L1 · R1 与“继续游玩”</string>

    <string name="whatsnew_090_art_title">给平台换新装</string>
    <string name="whatsnew_090_art_body">刮削真机照片和标志，或者给所有平台套上 Tandem 亲手画的四套美术套组：马卡龙糖果、霓虹街机厅、纸标签卡带、极简黑白。</string>
    <string name="whatsnew_090_art_short">平台图片</string>

    <string name="whatsnew_090_library_title">更多游戏，自动找到</string>
    <string name="whatsnew_090_library_body">DroidDeck（各大商店）和 GameNative 里的游戏会自己出现，一款游戏一个图块。在这两个应用开放游戏库之前，需要 root 权限。</string>
    <string name="whatsnew_090_library_short">DroidDeck 与 GameNative</string>

    <string name="whatsnew_090_share_title">分享、聆听、感受</string>
    <string name="whatsnew_090_share_body">把你的风格用文件、链接或二维码发出去，或者从社区画廊挑一个。再试试“麻将音”厚实的键盘敲击声，每次移动还会轻轻一震。</string>
    <string name="whatsnew_090_share_short">分享与麻将音</string>

    <!-- 0.10 的幻灯片 -->
    <string name="whatsnew_0100_tagline">挑一挑，转一转，理一理</string>

    <string name="whatsnew_0100_week_title">本周推荐，为你挑好了</string>
    <string name="whatsnew_0100_week_body">每周一，从你自己的游戏库里挑出一块推荐板，每款都附上理由：从上次停下的地方继续、就差一点通关、今晚就能玩完。X 重新抽这一排，Y 说「不感兴趣」。</string>
    <string name="whatsnew_0100_week_short">本周推荐</string>

    <string name="whatsnew_0100_surprise_title">随机来一款，转起来</string>
    <string name="whatsnew_0100_surprise_body">按 Select，封面转盘转起来，停在一款游戏上，优先从本周推荐里挑。按任意键都能叫停。</string>
    <string name="whatsnew_0100_surprise_short">随机来一款</string>

    <string name="whatsnew_0100_discs_title">多张光盘，一款游戏</string>
    <string name="whatsnew_0100_discs_body">多光盘游戏现在只占一个图块。模拟器要 .m3u？设置 › 游戏库与图片 会在光盘旁边帮你生成。</string>
    <string name="whatsnew_0100_discs_short">多光盘</string>

    <string name="whatsnew_0100_smart_title">排序更聪明</string>
    <string name="whatsnew_0100_smart_body">名称排序会跳过「The」，收藏可以排在最前；智能文件夹新增评分、开发商、发行商、游玩时长和上次游玩等规则，还能选全部条件或任一条件。</string>
    <string name="whatsnew_0100_smart_short">排序与规则</string>

    <string name="whatsnew_0100_search_title">搜索，加上筛选</string>
    <string name="whatsnew_0100_search_body">在搜索里按上键，按平台、类型、年份、评分、状态、玩过与否和收藏筛选。什么都不输入，就能逛遍整个游戏库。</string>
    <string name="whatsnew_0100_search_short">搜索筛选</string>

    <string name="whatsnew_0100_ra_title">成就，看个仔细</string>
    <string name="whatsnew_0100_ra_body">RetroAchievements 的完整成就列表，带筛选、排序和玩家提示，玩的时候另一屏也能看。光盘游戏现在按哈希值匹配。</string>
    <string name="whatsnew_0100_ra_short">RetroAchievements</string>

    <string name="whatsnew_0100_settings_title">设置一目了然</string>
    <string name="whatsnew_0100_settings_body">设置首页是八个图块，每块都有一幅会动的小速写，展示里面的内容。遇到怪事？「发送错误报告」帮你存一份，不用电脑。</string>
    <string name="whatsnew_0100_settings_short">设置</string>

    <string name="whatsnew_0100_music_title">阳光满满的新配乐 Plaza</string>
    <string name="whatsnew_0100_music_body">新的默认配乐是 Plaza：主页有口哨小调，设置里是温馨的波萨诺瓦，屏保时是八音盒华尔兹，有好消息时还有一小段欢快号角。可在 设置 › 声音与音乐 里更换。</string>
    <string name="whatsnew_0100_music_short">配乐</string>
</resources>
