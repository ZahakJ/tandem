    <string name="look_theme_decides">主题 · %1$s</string>

    <string name="look_accent">强调色</string>
    <string name="look_accent_help">用你自己的强调色来点缀开关和选中项。左右键试色板；按 A 看全部颜色，“输入颜色…”可以填任意颜色，比如 #FF7AB6。</string>
    <string name="look_accent_theme">主题</string>
    <string name="look_accent_type">输入颜色…</string>
    <string name="look_accent_hex">强调色（十六进制）</string>
    <string name="look_accent_bad">这看起来不像颜色</string>
    <string name="look_highlight">选中样式</string>
    <string name="look_highlight_help">选中的卡片怎么标出来：柔和的光晕、利落的描边、带大阴影的浮起，或是轻轻脉动的光圈。</string>
    <string name="look_surface">卡片材质</string>
    <string name="look_surface_help">卡片是什么做的：实色、透出壁纸光彩的毛玻璃，或是轻盈的线框。</string>

    <string name="look_icon_style">图标画风</string>
    <string name="look_icon_style_help">主题包没有自带平台图标时，Tandem 怎么画它们：一台对应类型的小设备配上平台名，有光泽泡泡、霓虹灯管、像素、液晶、镀铬等多种画风。</string>
    <string name="look_icons_from">图标来源</string>
    <string name="look_icons_from_help">在任何主题下使用某个图标包的平台图标、主视觉图和标志，或者一律由 Tandem 绘制。“自动”使用主题包自带的图片；用内置主题时，会借用 ROMs/assets/smart_folders 里的第一个 Cocoon 智能文件夹图标包。“Tandem 绘制”使用主题的图标画风。</string>
    <string name="look_icons_from_auto">自动</string>
    <string name="look_icons_from_drawn">Tandem 绘制</string>

    <string name="look_animation">动画风格</string>
    <string name="look_animation_help">Q 弹活泼俏皮，顺滑流畅不回弹，简约快速低调，关闭则瞬间切换。</string>
    <string name="look_reduce_motion">减弱动态效果</string>
    <string name="look_reduce_motion_help">关闭所有动态壁纸、平移的图片和弹跳动画。省电模式也会让壁纸静止。</string>

    <string name="look_wall_theme">主题默认</string>
    <string name="look_wall_hero">游戏图片（模糊）</string>
    <string name="look_wall_top">上屏</string>
    <string name="look_wall_top_help">动态背景、选中游戏的图片，或者你自己的图片或视频：把图片（PNG、JPG、WebP）或视频（MP4、WebM）拷进 ROMs/tandem/wallpapers，就会出现在这里。</string>
    <string name="look_wall_bottom">下屏</string>
    <string name="look_wall_bottom_help">第二块屏幕的同样选项。游戏图片和视频放在下面特别好看。</string>
    <string name="look_wall_dim">图片调暗</string>
    <string name="look_wall_dim_help">调暗图片和视频壁纸，让上面的文字更清楚。</string>

    <string name="look_games_view">游戏视图</string>
    <string name="look_games_view_help">平台或合集里游戏的显示方式：卡片网格、带资料的列表（游戏多时特别好用）、封面轮播、书架上的书脊，或卡带盒里的卡带。</string>
    <string name="look_games_grid_size">网格大小</string>
    <string name="look_games_grid_size_help">平台里游戏卡片的大小，或固定列数。</string>
    <string name="look_games_card_shape">卡片形状</string>
    <string name="look_games_card_shape_help">圆角、方形、圆形、竖版封面卡片，或适合截图和横幅的宽幅卡片。</string>
    <string name="look_games_shelf_look">书架样式</string>
    <string name="look_games_shelf_look_help">文件夹书架视图后面的书柜：温暖的木纹、主题色的哑光隔板，或开放式，卡带盒直接立在壁纸上，只留一道细细的隔板线。</string>
    <string name="look_games_titles">游戏标题</string>
    <string name="look_games_titles_help">在每张卡片下方写上游戏名称。</string>
    <string name="look_home_system_tiles">平台图块</string>
    <string name="look_home_system_tiles_help">主页上平台图块的样式。</string>
    <string name="look_home_rows">主页行</string>
    <string name="look_home_rows_help">主页显示哪些行，以及它们的顺序。</string>
    <string name="look_home_open_folders">打开文件夹</string>
    <string name="look_home_open_folders_help">以页面打开、以全屏页面打开（顶栏滑走，网格占满整个屏幕），或以弹窗盖在当前屏幕上。</string>
    <string name="look_home_open_folders_page">页面</string>
    <string name="look_home_open_folders_fullscreen">全屏</string>
    <string name="look_home_open_folders_popup">弹窗</string>
    <string name="look_home_now_playing">正在玩</string>
    <string name="look_home_now_playing_help">游戏在后台运行时，把它显示在主页顶部，方便你马上回去接着玩。</string>
    <string name="look_corner_hints">角落提示</string>
    <string name="look_corner_hints_help">在上屏角落显示小小的按键提示。</string>

    <string name="look_dock_apps">应用程序坞</string>
    <string name="look_dock_apps_help">把你最爱的 Android 应用放在主页上。在应用上按 Y 可以移动或移除它。</string>
    <string name="look_dock_style">程序坞样式</string>
    <string name="look_dock_style_help">悬浮栏、通栏搁板，或只显示图标。对“陈列架”以外的所有布局生效。</string>
    <string name="look_dock_top">程序坞置顶</string>
    <string name="look_dock_top_help">把程序坞放到图块上方，而不是下方。</string>
    <string name="look_dock_auto_hide">自动隐藏程序坞</string>
    <string name="look_dock_auto_hide_help">程序坞平时缩小变淡，移过去时才展开。</string>

    <string name="look_bottom_style">样式</string>
    <string name="look_bottom_style_help">“资料”让游戏图片渐渐融入它的信息。“图片 + 信息”让动态图片铺满屏幕，信息叠在上面。“动态图片”纯粹养眼。“时钟”安安静静。</string>
    <string name="look_bottom_logo_size">标志大小</string>
    <string name="look_bottom_logo_size_help">游戏标志叠在图片上的大小。</string>
    <string name="look_bottom_art_fade">图片渐隐</string>
    <string name="look_bottom_art_fade_help">图片如何融入下方的背景。</string>
    <string name="look_bottom_video_snaps">预览视频</string>
    <string name="look_bottom_video_snaps_help">在游戏上停留片刻后播放它的视频（来自 ROMs/downloaded_media/&lt;平台&gt;/videos）。“快速”开始得更早；“省电”等得更久，快速滚动时绝不解码视频。始终静音，游戏时停止。</string>
    <string name="look_bottom_video_snaps_fast">快速</string>
    <string name="look_bottom_video_snaps_balanced">均衡</string>
    <string name="look_bottom_video_snaps_saver">省电</string>
    <string name="look_bottom_moving_art">动态画面</string>
    <string name="look_bottom_moving_art_help">游戏图片缓缓平移和缩放，像一张会呼吸的海报。</string>

    <string name="look_top_battery">电量</string>
    <string name="look_top_battery_help">在时钟旁显示电量百分比。</string>
    <string name="look_top_clock">时钟</string>
    <string name="look_top_clock_help">12 小时制、24 小时制、跟随系统，或者不显示时钟。</string>
    <string name="look_top_clock_system">跟随系统</string>
    <string name="look_top_clock_12">12 小时制</string>
    <string name="look_top_clock_24">24 小时制</string>
    <string name="look_top_clock_hidden">隐藏</string>

    <string name="look_controls_prompts">按键图标</string>
    <string name="look_controls_prompts_help">提示里的按键怎么画：Tandem 的粉彩风格，或 Xbox、PlayStation、任天堂风格。</string>
    <string name="look_controls_swap_ab">交换 A 和 B</string>
    <string name="look_controls_swap_ab_help">用 B 确认、用 A 返回，和任天堂主机一样。提示也会跟着变。</string>
    <string name="look_controls_swap_xy">交换 X 和 Y</string>
    <string name="look_controls_swap_xy_help">用 Y 搜索，用 X 打开选项。</string>
    <string name="look_controls_does_open">打开</string>
    <string name="look_controls_does_search">搜索</string>
    <string name="look_controls_does_options">选项</string>
    <string name="look_controls_rebind">按键映射</string>
    <string name="look_controls_rebind_help">给 Tandem 的任意指令换一个按键、一组同时按下的组合键，或长按某个键：打开、返回、选项菜单、Start、快速设置、游戏切换器、侧边栏、翻页、隐藏的游戏，还有收藏、截图和录屏片段的按键。所有提示都会跟着变。</string>
    <string name="look_controls_rebind_defaults">默认</string>
    <plurals name="look_controls_rebind_changes">
        <item quantity="other">%1$d 处更改</item>
    </plurals>

    <string name="look_screens_swap">交换屏幕</string>
    <string name="look_screens_swap_help">游戏库移到下屏（触屏），资料放到上屏，瞬间完成。在图标网格上按 X 也一样。游戏仍在上屏打开。</string>
    <string name="look_screens_rotation">保持自动旋转关闭</string>
    <string name="look_screens_rotation_help">Thor 时不时会自己把自动旋转打开。每次你回到 Tandem，它都会再关掉。关闭此项，就由你自己决定。</string>

    <string name="look_reset">重置外观</string>
    <string name="look_reset_help">回到 Tandem 最初的外观：主题、布局、壁纸、图标和动态效果。你的按键、屏幕、音效和音乐、游戏库、收藏和游玩时长都不会动。</string>
    <string name="look_reset_ask">要重置整个外观吗？</string>
    <string name="look_reset_ask_body">主题、布局、壁纸、图标和动态效果会回到 Tandem 最初的样子。按键、屏幕、声音和游戏保持不变。</string>
    <string name="look_reset_ask_do">重置</string>
    <string name="look_reset_done">已恢复为 %1$s</string>

    <string name="look_grid_icon_size">图标大小</string>
    <string name="look_grid_icon_size_help">一行能放几个图标，就像 3DS HOME 菜单的缩放。在网格上按 L1 和 R1 也能调。</string>
    <string name="look_grid_icon_size_option">%1$s · 每行 %2$d 个</string>
    <string name="look_grid_rows">图标行数</string>
    <string name="look_grid_rows_help">固定行数后，图标会放大填满屏幕。一行就是 3DS HOME 菜单放到最大：大大的图标，上方显示选中项的资料。“自动”跟随图标大小。在网格上按 L1 和 R1 可以改行数（图标为“大”时再按 L1 会继续减少行数）。</string>
    <string name="look_grid_rows_auto">自动</string>
    <plurals name="look_grid_rows_n">
        <item quantity="other">%1$d 行</item>
    </plurals>
    <string name="look_grid_scrolling">滚动方式</string>
    <string name="look_grid_scrolling_help">横向滚动并露出下一屏的一角、一次翻一页（像 3DS 那样），或上下滚动。</string>
    <string name="look_grid_scrolling_sideways">横向</string>
    <string name="look_grid_scrolling_pages">翻页</string>
    <string name="look_grid_scrolling_vertical">上下</string>
    <string name="look_grid_roundness">图标圆角</string>
    <string name="look_grid_roundness_help">从直角到圆形。</string>
    <string name="look_grid_gap">图标间距</string>
    <string name="look_grid_gap_help">图标之间的空隙，按图标大小的比例计算。</string>
    <string name="look_grid_hero_split">主视觉分屏</string>
    <string name="look_grid_hero_split_help">在网格上方显示选中图标的图片。“不分屏”（默认）让图标占满整个屏幕。</string>
    <string name="look_grid_hero_split_none">不分屏</string>
    <string name="look_grid_other_screen">另一屏</string>
    <string name="look_grid_other_screen_help">“聚光灯”把选中的图标放大显示在它的颜色上（或图标包的图片上），游戏则全屏显示。“经典”显示 Tandem 的资料。</string>
    <string name="look_grid_other_screen_spotlight">聚光灯</string>
    <string name="look_grid_other_screen_classic">经典</string>
    <string name="look_grid_folders">文件夹打开方式</string>
    <string name="look_grid_folders_help">以大圆角面板盖在网格上，或以整页打开。</string>
    <string name="look_grid_folders_popup">盖在网格上</string>
    <string name="look_grid_folders_page">整页</string>
    <string name="look_grid_x_button">X 键</string>
    <string name="look_grid_x_button_help">在图标网格和轨道主页上用 X 交换两块屏幕（搜索在 Start 面板和网格的 Y 菜单里）、在所有地方都用来交换，或者让 X 保持搜索。</string>
    <string name="look_grid_x_button_swap_grid">网格和轨道上交换</string>
    <string name="look_grid_x_button_swap">处处交换</string>
    <string name="look_grid_x_button_search">搜索</string>
    <string name="look_grid_swap_animation">交换动画</string>
    <string name="look_grid_swap_animation_help">按 X 时两块屏幕怎么换位。散落：图标四散飞开，落到另一块屏幕上。推入：每块屏幕的新内容从转轴处滑进来。翻转：两块屏幕像卡片一样翻面。纵深：旧画面往后沉，新画面迎面而来。</string>
    <string name="look_swap_scatter">散落</string>
    <string name="look_swap_push">推入</string>
    <string name="look_swap_flip">翻转</string>
    <string name="look_swap_depth">纵深</string>
    <string name="look_swap_fade">淡入淡出</string>
    <string name="look_swap_instant">瞬间</string>

    <string name="look_home_rows_continue">继续游玩</string>
    <string name="look_home_rows_systems">平台</string>
    <string name="look_home_rows_collections">合集</string>

    <string name="look_gallery_themes">主题</string>
