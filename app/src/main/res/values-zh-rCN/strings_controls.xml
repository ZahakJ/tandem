<resources>
    <string name="controls_group_home_button">手柄 Home 键</string>
    <string name="controls_group_controllers">游戏手柄</string>
    <string name="controls_group_pad_link">用手柄玩</string>

    <string name="controls_home_button">手柄 Home 键</string>
    <string name="controls_home_button_help">很多手柄在 X-input 模式下，会把 Home（导航）键当成一个 Android 不理会的按键发出来。在 Tandem 里它始终能当 Home 键用。想让它在游戏和其他应用里也生效，请在 Android 的“无障碍”设置里打开“Tandem: Controller Home button”（按 A 打开设置；如果是灰色的，先在 Tandem 的“应用信息”里允许受限设置）。之后 Tandem 只关注这一个按键，而且只来自外接手柄；内置按键一概不碰。</string>
    <string name="controls_open">打开</string>
    <string name="controls_hold_home">长按 Home 键</string>
    <string name="controls_hold_home_help">长按手柄 Home 键的作用：Tandem 的游戏切换器，或 Android 的最近任务（需要开启“手柄 Home 键”；没开的话就是游戏切换器）。</string>
    <string name="controls_hold_home_switcher">游戏切换器</string>
    <string name="controls_hold_home_recents">最近任务</string>

    <string name="controls_pad_nintendo_help">任天堂按键布局：只为这个手柄交换 A/B 和 X/Y，让印着 A 的键用来确认。适合 X-input 模式下的 Switch 风格手柄。只在 Tandem 内生效；内置按键和其他手柄不受影响，上面的“交换 A 和 B”仍会叠加生效。模拟器在各自的设置里有每个手柄的按键映射。</string>
    <string name="controls_pad_unnamed">手柄</string>
    <string name="controls_pad_numbered">%1$s %2$d</string>
    <string name="controls_no_pads">没有其他手柄</string>
    <string name="controls_no_pads_value">连接一个</string>
    <string name="controls_no_pads_help">配对蓝牙手柄或插上有线手柄，它就会出现在这里，并有自己的任天堂按键布局开关（只为这个手柄交换 A/B 和 X/Y）。内置按键跟随上面的“交换 A 和 B”。</string>
    <string name="controls_no_pads_toast">配对或插上手柄，它就会出现在这里</string>
    <string name="controls_pads_note">开：任天堂布局</string>

    <string name="controls_link">游戏中的手柄</string>
    <string name="controls_link_unavailable">不可用</string>
    <string name="controls_link_help">选择哪个手柄充当内置手柄，在所有模拟器中都有效，游戏进行中也行：游戏继续监听内置按键，Tandem 把所选手柄的按键和摇杆转发过去。内置按键也照样能用（快速设置里也能切换）。游戏中连上的手柄会在下屏毛遂自荐：按它的 A 或 Start 即可。断开后会回到内置按键。</string>
    <string name="controls_link_builtin">内置</string>
    <string name="controls_link_auto">总是用已连接的手柄</string>
    <string name="controls_link_auto_help">总是使用已连接的手柄：一连上就立刻充当内置手柄，不再询问。想双人游戏就关掉它：这样手柄保持独立，模拟器里需要把它映射为玩家 2。</string>
    <string name="controls_link_in_use">使用中：%1$s</string>

    <string name="controls_binding_hold">长按 %1$s</string>
    <string name="controls_binding_none">没有按键</string>
    <string name="controls_binding_none_value">无按键</string>

    <string name="controls_clock_system">跟随系统</string>
    <string name="controls_clock_12">12 小时制</string>
    <string name="controls_clock_24">24 小时制</string>
    <string name="controls_clock_off">隐藏</string>

    <string name="controls_command_open">打开 / 选择</string>
    <string name="controls_command_open_help">打开选中项或开始游戏；在按钮和设置行上就是 A。</string>
    <string name="controls_command_back">返回</string>
    <string name="controls_command_back_help">返回，或关闭菜单和面板。</string>
    <string name="controls_command_options">游戏选项</string>
    <string name="controls_command_options_help">选中游戏、平台、文件夹或应用的选项菜单；在触屏上就是长按。</string>
    <string name="controls_command_action">交换屏幕 / 搜索</string>
    <string name="controls_command_action_help">搜索，或在图标网格上交换两块屏幕，取决于“X 键”的设置。在键盘上是删除一个字。</string>
    <string name="controls_command_start">Start 菜单</string>
    <string name="controls_command_start_help">打开 Start 面板；在设置里是关闭设置，在表单里是确认。</string>
    <string name="controls_command_quick">快速设置</string>
    <string name="controls_command_quick_help">亮度、音量、Wi-Fi、省电模式和其他快捷开关。</string>
    <string name="controls_command_switcher">运行中的游戏</string>
    <string name="controls_command_switcher_help">所有开着的游戏，可以继续或关闭。</string>
    <string name="controls_command_switcher_chord">运行中的游戏（组合键）</string>
    <string name="controls_command_switcher_chord_help">同样是游戏切换器，用同时按下的组合键打开：默认是 Select 加 Start。</string>
    <string name="controls_command_surprise">随机来一款</string>
    <string name="controls_command_surprise_help">跳到一款你从没玩过的随机游戏。在消息上也是“撤销”，在应用里是 Select。</string>
    <string name="controls_command_hidden">隐藏的游戏</string>
    <string name="controls_command_hidden_help">隐私模式关闭时：立刻开启它。开启时：输入 PIN 后显示隐藏的游戏，或把它们藏起来。</string>
    <string name="controls_command_previous">上一个标签或页面</string>
    <string name="controls_command_previous_help">上一个平台、合集、设置页或统计标签；在网格上是放大图标。</string>
    <string name="controls_command_next">下一个标签或页面</string>
    <string name="controls_command_next_help">下一个平台、合集、设置页或统计标签；在网格上是缩小图标。</string>
    <string name="controls_command_page_up">向上翻页</string>
    <string name="controls_command_page_up_help">在游戏列表里跳到上一个字母（或年份、评分），在其他地方向上翻一页；在网格上是“最近玩过”栏。</string>
    <string name="controls_command_page_down">向下翻页</string>
    <string name="controls_command_page_down_help">在游戏列表里跳到下一个字母（或年份、评分），在其他地方向下翻一页。</string>
    <string name="controls_command_side_panel">侧边栏</string>
    <string name="controls_command_side_panel_help">在主页上：Pip、快速设置和你的通知。默认和“向下翻页”共用一个键。</string>
    <string name="controls_command_favourite">收藏</string>
    <string name="controls_command_favourite_help">把选中的游戏加入收藏，或再取消收藏。默认没有按键，需要你自己分配。</string>
    <string name="controls_command_screenshot">截图</string>
    <string name="controls_command_screenshot_help">截下另一块屏幕上正在运行的游戏，保存到 ROMs/screenshots，和游戏助手里的“截图”一样。在 Tandem 处于前台时可用。</string>
    <string name="controls_command_clip">录屏片段</string>
    <string name="controls_command_clip_help">录下另一块屏幕上游戏的 15 秒片段，或停止正在录的那段，和游戏助手里的“片段”一样。在 Tandem 处于前台时可用。</string>
    <string name="controls_command_home">手柄 Home</string>
    <string name="controls_command_home_help">手柄的 Home（导航）键在 Tandem 里的作用：短按是 Home，长按的作用由“长按 Home 键”决定。</string>

